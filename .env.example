VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Leave blank to run in local demo mode (seeded mock data, no network).

# Optional: set to "true" if Google OAuth is enabled in your Supabase Auth providers
# VITE_GOOGLE_AUTH_ENABLED=

# Optional: PayMongo public key (live e-wallet wiring still needs an Edge Function secret)
# VITE_PAYMONGO_PUBLIC_KEY=

# NOTE: Resend (RESEND_API_KEY) is server-side only — set it in Supabase Edge Function secrets & Auth SMTP, never in VITE_* variables.
